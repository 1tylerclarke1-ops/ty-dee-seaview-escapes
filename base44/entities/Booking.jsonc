{
  "name": "Booking",
  "type": "object",
  "properties": {
    "guest_name": {
      "type": "string",
      "title": "Guest name"
    },
    "guest_email": {
      "type": "string",
      "format": "email",
      "title": "Guest email"
    },
    "arrival_date": {
      "type": "string",
      "format": "date",
      "title": "Arrival date"
    },
    "departure_date": {
      "type": "string",
      "format": "date",
      "title": "Departure date"
    },
    "nights": {
      "type": "number",
      "title": "Nights"
    },
    "guests": {
      "type": "number",
      "title": "Guests"
    },
    "dogs": {
      "type": "boolean",
      "default": false,
      "title": "Dogs"
    },
    "dog_count": {
      "type": "number",
      "default": 0,
      "title": "Dog count"
    },
    "status": {
      "type": "string",
      "enum": [
        "enquiry",
        "held",
        "deposit_paid",
        "confirmed",
        "cancelled",
        "expired"
      ],
      "default": "enquiry",
      "title": "Status"
    },
    "reference": {
      "type": "string",
      "title": "Booking reference (TD-YYMMDD-XXX)"
    },
    "cancel_token": {
      "type": "string",
      "title": "Long single-use token for the guest's manage/cancel link"
    },
    "payment_provider": {
      "type": "string",
      "default": "stripe",
      "title": "Payment provider"
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "title": "Stripe payment intent id (stored at payment)"
    },
    "stripe_session_id": {
      "type": "string",
      "title": "Stripe checkout session id"
    },
    "stripe_fee": {
      "type": "number",
      "default": 0,
      "title": "Stripe processing fee (actual, stored at payment)"
    },
    "hold_expires_at": {
      "type": "string",
      "format": "date-time",
      "title": "Hold expiry (30 min from creation)"
    },
    "source": {
      "type": "string",
      "title": "Acquisition source (UTM / how-heard)"
    },
    "gross_revenue": {
      "type": "number",
      "default": 0,
      "title": "Gross revenue"
    },
    "damage_waiver": {
      "type": "number",
      "default": 0,
      "title": "Damage waiver (historical \u2014 not charged on new bookings)"
    },
    "deposit_paid": {
      "type": "number",
      "default": 0,
      "title": "Deposit paid"
    },
    "balance_paid": {
      "type": "number",
      "default": 0,
      "title": "Balance paid"
    },
    "balance_paid_email_sent": {
      "type": "boolean",
      "default": false,
      "title": "Balance paid confirmation email sent"
    },
    "balance_reminders_sent": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "Balance reminders sent (e.g. [\"70\",\"60\",\"57\",\"55\",\"53\"])"
    },
    "balance_overdue_flagged": {
      "type": "boolean",
      "default": false,
      "title": "Balance overdue flagged (admin action needed at 53 days)"
    },
    "text_reminder_flagged": {
      "type": "boolean",
      "default": false,
      "title": "Text reminder flagged (day 55 \u2014 owner to text guest)"
    },
    "text_reminder_phone": {
      "type": "string",
      "title": "Phone number captured at text-reminder flag time"
    },
    "cancellation_reason": {
      "type": "string",
      "enum": [
        "unpaid_balance",
        "guest_initiated",
        "admin"
      ],
      "title": "Cancellation reason"
    },
    "auto_cancelled_at": {
      "type": "string",
      "format": "date-time",
      "title": "Auto-cancelled at (for the 24-hour undo window)"
    },
    "deposit_retained": {
      "type": "number",
      "default": 0,
      "title": "Amount retained on cancellation"
    },
    "refund_due": {
      "type": "number",
      "default": 0,
      "title": "Refund due"
    },
    "refund_paid": {
      "type": "number",
      "default": 0,
      "title": "Refund paid"
    },
    "refund_date": {
      "type": "string",
      "format": "date",
      "title": "Refund date"
    },
    "refund_tier": {
      "type": "string",
      "title": "Refund tier applied"
    },
    "cancellation_policy_text": {
      "type": "string",
      "title": "Cancellation policy text agreed at booking"
    },
    "cooling_off_expires_at": {
      "type": "string",
      "format": "date-time",
      "title": "Cooling-off window expiry (fixed at booking)"
    },
    "confirmation_email_sent": {
      "type": "boolean",
      "default": false,
      "title": "Confirmation email sent to guest"
    },
    "owner_alert_sent": {
      "type": "boolean",
      "default": false,
      "title": "Owner alert email sent"
    },
    "cancellation_email_sent": {
      "type": "boolean",
      "default": false,
      "title": "Cancellation confirmation email sent to guest"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "facilities_acknowledged": {
      "type": "boolean",
      "default": false,
      "title": "Facilities acknowledged"
    },
    "facilities_acknowledged_at": {
      "type": "string",
      "format": "date-time",
      "title": "Facilities acknowledged at"
    },
    "post_stay_sent": {
      "type": "boolean",
      "default": false,
      "title": "Post-stay email sent"
    }
  },
  "required": [
    "guest_name",
    "arrival_date",
    "nights",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}