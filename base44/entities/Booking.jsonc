{
  "name": "Booking",
  "type": "object",
  "properties": {
    "guest_name": {
      "type": "string",
      "title": "Guest name"
    },
    "guest_email": {
      "type": "string",
      "format": "email",
      "title": "Guest email"
    },
    "arrival_date": {
      "type": "string",
      "format": "date",
      "title": "Arrival date"
    },
    "departure_date": {
      "type": "string",
      "format": "date",
      "title": "Departure date"
    },
    "nights": {
      "type": "number",
      "title": "Nights"
    },
    "guests": {
      "type": "number",
      "title": "Guests"
    },
    "status": {
      "type": "string",
      "enum": [
        "enquiry",
        "held",
        "deposit_paid",
        "confirmed",
        "cancelled"
      ],
      "default": "enquiry",
      "title": "Status"
    },
    "gross_revenue": {
      "type": "number",
      "default": 0,
      "title": "Gross revenue"
    },
    "deposit_paid": {
      "type": "number",
      "default": 0,
      "title": "Deposit paid"
    },
    "deposit_retained": {
      "type": "number",
      "default": 0,
      "title": "Deposit retained on cancellation"
    },
    "dogs": {
      "type": "boolean",
      "default": false,
      "title": "Dogs"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "guest_name",
    "arrival_date",
    "nights",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}