{
  "name": "Booking",
  "type": "object",
  "properties": {
    "guest_name": {
      "type": "string",
      "title": "Guest name"
    },
    "guest_email": {
      "type": "string",
      "format": "email",
      "title": "Guest email"
    },
    "arrival_date": {
      "type": "string",
      "format": "date",
      "title": "Arrival date"
    },
    "departure_date": {
      "type": "string",
      "format": "date",
      "title": "Departure date"
    },
    "nights": {
      "type": "number",
      "title": "Nights"
    },
    "guests": {
      "type": "number",
      "title": "Guests"
    },
    "status": {
      "type": "string",
      "enum": [
        "enquiry",
        "held",
        "deposit_paid",
        "confirmed",
        "cancelled"
      ],
      "default": "enquiry",
      "title": "Status"
    },
    "source": {
      "type": "string",
      "title": "Acquisition source (UTM / how-heard)"
    },
    "gross_revenue": {
      "type": "number",
      "default": 0,
      "title": "Gross revenue"
    },
    "deposit_paid": {
      "type": "number",
      "default": 0,
      "title": "Deposit paid"
    },
    "balance_paid": {
      "type": "number",
      "default": 0,
      "title": "Balance paid"
    },
    "deposit_retained": {
      "type": "number",
      "default": 0,
      "title": "Amount retained on cancellation"
    },
    "refund_due": {
      "type": "number",
      "default": 0,
      "title": "Refund due"
    },
    "refund_paid": {
      "type": "number",
      "default": 0,
      "title": "Refund paid"
    },
    "refund_date": {
      "type": "string",
      "format": "date",
      "title": "Refund date"
    },
    "refund_tier": {
      "type": "string",
      "title": "Refund tier applied"
    },
    "cancellation_policy_text": {
      "type": "string",
      "title": "Cancellation policy text agreed at booking"
    },
    "cooling_off_expires_at": {
      "type": "string",
      "format": "date-time",
      "title": "Cooling-off window expiry (fixed at booking)"
    },
    "dogs": {
      "type": "boolean",
      "default": false,
      "title": "Dogs"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "facilities_acknowledged": {
      "type": "boolean",
      "default": false,
      "title": "Facilities acknowledged"
    },
    "facilities_acknowledged_at": {
      "type": "string",
      "format": "date-time",
      "title": "Facilities acknowledged at"
    },
    "post_stay_sent": {
      "type": "boolean",
      "default": false,
      "title": "Post-stay email sent"
    }
  },
  "required": [
    "guest_name",
    "arrival_date",
    "nights",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}