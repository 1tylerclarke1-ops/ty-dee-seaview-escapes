{
  "name": "Contact",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "source": {
      "type": "string",
      "enum": [
        "past_guest",
        "enquiry",
        "manual",
        "website"
      ],
      "default": "enquiry",
      "title": "Source"
    },
    "acquisition_source": {
      "type": "string",
      "title": "Acquisition source (UTM / how-heard)"
    },
    "first_seen": {
      "type": "string",
      "format": "date",
      "title": "First seen"
    },
    "last_stayed": {
      "type": "string",
      "format": "date",
      "title": "Last stayed"
    },
    "stays_count": {
      "type": "number",
      "default": 0,
      "title": "Stays count"
    },
    "total_spent": {
      "type": "number",
      "default": 0,
      "title": "Total spent"
    },
    "has_dog": {
      "type": "boolean",
      "default": false,
      "title": "Has dog"
    },
    "dog_count": {
      "type": "number",
      "default": 0,
      "title": "Dog count"
    },
    "party_size_typical": {
      "type": "number",
      "title": "Typical party size"
    },
    "months_stayed": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "title": "Months stayed"
    },
    "marketing_consent": {
      "type": "boolean",
      "default": false,
      "title": "Marketing consent"
    },
    "consent_date": {
      "type": "string",
      "format": "date-time",
      "title": "Consent date"
    },
    "consent_source": {
      "type": "string",
      "title": "Consent source"
    },
    "unsubscribed": {
      "type": "boolean",
      "default": false,
      "title": "Unsubscribed"
    },
    "unsubscribe_date": {
      "type": "string",
      "format": "date",
      "title": "Unsubscribe date"
    },
    "unsubscribe_token": {
      "type": "string",
      "title": "Unsubscribe token"
    },
    "referral_code": {
      "type": "string",
      "title": "Referral code (unique, per past guest)"
    },
    "referred_by": {
      "type": "string",
      "title": "Referral code of the guest who referred this contact"
    },
    "referral_credits_earned": {
      "type": "number",
      "default": 0,
      "title": "Referral credits earned (\u00a3)"
    },
    "cancellation_acknowledged": {
      "type": "boolean",
      "default": false,
      "title": "Cancellation acknowledgement (past full-refund window)"
    },
    "cancellation_acknowledged_at": {
      "type": "string",
      "format": "date-time",
      "title": "Cancellation acknowledged at"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "last_enquiry_message": {
      "type": "string",
      "title": "Latest contact-form enquiry message"
    },
    "last_enquiry_at": {
      "type": "string",
      "format": "date-time",
      "title": "When the latest enquiry arrived"
    },
    "enquiry_digest_sent": {
      "type": "boolean",
      "default": false,
      "title": "Included in an owner digest (prevents re-telling)"
    },
    "enquiry_resolved": {
      "type": "boolean",
      "default": false,
      "title": "Resolved by the owner (clears the dashboard banner)"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}