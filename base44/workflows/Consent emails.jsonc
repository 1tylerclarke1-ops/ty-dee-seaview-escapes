{
  "description": "Daily 09:00 \u2014 sends the marketing-consent ask 14 days after departure, only to guests who left a review and have not already consented or unsubscribed. One ask, no chase.",
  "name": "Consent emails",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "consent_emails",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_job": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendConsentEmails",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Send consent emails",
            "description": "Consent ask, 14 days after departure, to reviewers only"
          }
        }
      }
    ]
  }
}